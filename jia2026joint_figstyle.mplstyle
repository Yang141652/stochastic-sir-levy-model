# jia2026joint shared figure style (Session 25). Used by F3a and by every WU-N figure.
# Okabe-Ito palette (safe for colour-blind readers); serif text matching the elsarticle body.
font.family: serif
font.serif: DejaVu Serif, Times New Roman, Times
mathtext.fontset: cm
font.size: 9
axes.labelsize: 10
axes.titlesize: 10
legend.fontsize: 8
xtick.labelsize: 8
ytick.labelsize: 8
axes.linewidth: 0.7
lines.linewidth: 1.3
xtick.direction: out
ytick.direction: out
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
